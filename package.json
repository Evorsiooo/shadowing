{
  "name": "euno-shadowing",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Euno Shadowing: daily accent practice by shadowing, on Cloudflare Pages",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler pages dev",
    "setup": "node scripts/setup.mjs",
    "deploy:reminders": "wrangler deploy -c workers/reminders/wrangler.toml",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:heavy": "node scripts/test-heavy.mjs",
    "test:phones": "node --test src/phones/test/*.test.mjs",
    "test:words": "node --test src/words/test/*.test.mjs && node scripts/test-words.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "3.3.3",
    "esbuild": "0.28.1",
    "onnxruntime-web": "1.20.1",
    "wrangler": "4.143.1"
  }
}
